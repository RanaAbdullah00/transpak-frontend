# ─── Production (Cloudflare Pages / `npm run build`) ───
# Required — backend ORIGIN only (no /api or /auth paths). No trailing slash.
# Correct:   https://transpak-backend-1.onrender.com
# Wrong:     https://transpak-backend-1.onrender.com/api/auth/signup
VITE_API_URL=https://transpak-backend-1.onrender.com

# Log auth request method + URL + payload in dev (passwords redacted)
# VITE_AUTH_API_DEBUG=true

# Optional Socket.io origin (defaults to VITE_API_URL without /api).
# VITE_SOCKET_URL=https://transpak-backend-1.onrender.com

# Cloudflare Pages: set VITE_API_URL in Project → Settings → Environment variables
# (build-time). Changing .env.production alone does nothing until you rebuild & deploy.

# ─── Local dev only (`npm run dev`) ───
# Leave VITE_API_URL unset to use `/api` + Vite proxy below.
# VITE_PROXY_TARGET must match transpak-backend PORT (see server log).
VITE_PROXY_TARGET=http://127.0.0.1:5000
