# ─── Production (Cloudflare Pages / `npm run build`) ───
# Required — baked into the SPA. No trailing slash. Do not use localhost in production.
VITE_API_URL=https://transpak-backend-1.onrender.com

# Optional Socket.io origin (defaults to VITE_API_URL without /api).
# VITE_SOCKET_URL=https://transpak-backend.onrender.com

# ─── Local dev only (`npm run dev`) ───
# Leave VITE_API_URL unset to use `/api` + Vite proxy below.
# VITE_PROXY_TARGET must match transpak-backend PORT (see server log).
VITE_PROXY_TARGET=http://127.0.0.1:5000
