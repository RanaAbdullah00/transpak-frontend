# ─── Production (Cloudflare Pages build) ───
# Set in Project → Settings → Environment variables (build-time).
# VITE_API_URL=https://transpak-backend-1.onrender.com

# Optional: pin expected backend build id from /api/health
# VITE_EXPECTED_API_BUILD=

# Optional Socket.io origin (defaults to VITE_API_URL origin)
# VITE_SOCKET_URL=https://transpak-backend-1.onrender.com

# Log all API requests/responses in dev (passwords redacted). Also logs errors in production.
# VITE_API_DEBUG=true

# Log auth request/response in dev (passwords redacted)
# VITE_AUTH_API_DEBUG=true

# Phase 8 — realtime / cache tuning (optional)
# VITE_NOTIFICATION_POLL_MS=28000
# VITE_CACHE_RECONCILE_MS=300000
# VITE_SOCKET_RECONNECT_MIN_MS=2200
# VITE_SOCKET_MAX_RECONNECT=30
# VITE_WORKSPACE_CACHE_TTL_MS=120000

# Local dev (`npm run dev`) — leave VITE_API_URL unset; requests use same-origin `/api` via Vite proxy.
# VITE_PROXY_TARGET must match transpak-backend PORT (see server startup log; default 10000).
VITE_PROXY_TARGET=http://127.0.0.1:10000
